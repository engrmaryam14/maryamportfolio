---
const experience = {
  role: "Junior Web Developer",
  company: "Web Development & Graphic Design",
  period: "2025 – Present",
  points: [
    "Create responsive, mobile-friendly websites using HTML, CSS, and JavaScript, thoroughly tested across diverse devices and browsers.",
    "Develop programming projects using Python and C++, applying robust data structures, algorithms, and problem-solving patterns.",
    "Build, customize, and manage WordPress websites, handling custom themes, plugins, and dynamic content updates.",
    "Design high-impact logos and graphics for web and brand identity, producing polished visual assets for client websites.",
    "Harness leading AI tools (ChatGPT, Claude, Google Gemini) to accelerate code generation, debugging, and content drafting with rigorous manual review.",
  ],
};

const education = {
  degree: "Bachelor of Science in Software Engineering",
  university: "University of Kotli, AJK",
  period: "2022 – 2026",
  location: "Kotli, AJK",
  coursework: [
    "Data Structures",
    "Algorithms",
    "Artificial Intelligence",
    "Machine Learning",
    "Database Systems",
    "Computer Networks",
    "Operating Systems",
    "Cloud Computing",
    "Mobile Application Development",
    "Human-Computer Interaction",
  ],
};

const softSkills = [
  "Problem Solving",
  "Critical Thinking",
  "Communication",
  "Team Collaboration",
  "Time Management",
  "Adaptability",
  "Continuous Learning",
];

const languages = [
  { name: "English", level: "Professional Working Proficiency" },
  { name: "Urdu", level: "Native / Bilingual Proficiency" },
];
---

<section id="experience" class="py-12 sm:py-16 border-t border-[#ffffff10] text-[var(--white)] w-full">
  <div class="space-y-8 sm:space-y-12">
    <!-- Section Header -->
    <div>
      <h2 class="text-base sm:text-lg text-[var(--sec)] mb-1.5 font-medium shiny-sec">Background &amp; Expertise</h2>
      <h3 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight">Experience &amp; Education</h3>
    </div>

    <!-- Experience & Education Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
      <!-- Professional Experience Card -->
      <div class="p-5 sm:p-7 md:p-8 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)] hover:border-[#ffffff25] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] sm:text-xs font-semibold uppercase tracking-wider bg-[var(--sec-glow)] text-[var(--sec-bright)] border border-[var(--sec)]/30">
              <span class="size-1.5 rounded-full bg-[var(--sec)] flex-shrink-0"></span>
              Professional Experience
            </span>
            <span class="text-xs font-mono text-[var(--white-icon)] bg-[#ffffff0a] px-2.5 py-1 rounded-md">
              {experience.period}
            </span>
          </div>

          <h4 class="text-xl sm:text-2xl font-bold text-white mb-1 leading-snug">{experience.role}</h4>
          <p class="text-xs sm:text-sm font-medium text-[var(--sec-bright)] mb-5 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>{experience.company}</span>
          </p>

          <ul class="space-y-2.5 text-xs sm:text-sm text-[var(--white-icon)] leading-relaxed">
            {
              experience.points.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-[var(--sec)] text-sm sm:text-base leading-none mt-0.5">•</span>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-[#ffffff0a] flex items-center gap-2 text-xs text-[var(--white-icon)]">
          <span class="text-white font-medium flex-shrink-0">Core Stack:</span> 
          <span class="truncate">HTML5, CSS3, JS, Python, C++, WordPress, AI Tools</span>
        </div>
      </div>

      <!-- Education Card -->
      <div class="p-5 sm:p-7 md:p-8 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)] hover:border-[#ffffff25] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] sm:text-xs font-semibold uppercase tracking-wider bg-[#34d399]/10 text-[#34d399] border border-[#34d399]/30">
              <span class="size-1.5 rounded-full bg-[#34d399] flex-shrink-0"></span>
              Academics
            </span>
            <span class="text-xs font-mono text-[var(--white-icon)] bg-[#ffffff0a] px-2.5 py-1 rounded-md">
              {education.period}
            </span>
          </div>

          <h4 class="text-xl sm:text-2xl font-bold text-white mb-1 leading-snug">{education.degree}</h4>
          <p class="text-xs sm:text-sm font-medium text-[#34d399] mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            <span>{education.university} • {education.location}</span>
          </p>

          <p class="text-[11px] sm:text-xs uppercase tracking-wider text-[var(--white-icon)] font-semibold mb-2.5">
            Relevant Coursework
          </p>
          <div class="flex flex-wrap gap-1.5 sm:gap-2">
            {
              education.coursework.map((course) => (
                <span class="text-[11px] sm:text-xs px-2.5 py-1 rounded-lg bg-[#ffffff0a] border border-[#ffffff10] text-[var(--white)] hover:border-[var(--sec)] transition-colors">
                  {course}
                </span>
              ))
            }
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#ffffff0a] text-xs text-[var(--white-icon)]">
          <span class="text-[#34d399] font-medium">Final Year Project:</span> Cross-platform Web &amp; Mobile finance system on real-time cloud backend.
        </div>
      </div>
    </div>

    <!-- Soft Skills & Languages Bar -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 pt-2">
      <!-- Soft Skills -->
      <div class="p-5 sm:p-6 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)]">
        <h5 class="text-xs sm:text-sm uppercase tracking-wider text-[var(--sec-bright)] font-semibold mb-3 sm:mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/></svg>
          Professional Strengths &amp; Soft Skills
        </h5>
        <div class="flex flex-wrap gap-1.5 sm:gap-2">
          {
            softSkills.map((skill) => (
              <span class="text-xs sm:text-sm px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full bg-[#ffffff0a] border border-[#ffffff12] text-white">
                {skill}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Languages -->
      <div class="p-5 sm:p-6 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)]">
        <h5 class="text-xs sm:text-sm uppercase tracking-wider text-[var(--sec-bright)] font-semibold mb-3 sm:mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Languages
        </h5>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
          {
            languages.map((lang) => (
              <div class="p-3 rounded-xl bg-[#ffffff08] border border-[#ffffff10]">
                <p class="text-sm sm:text-base font-semibold text-white">{lang.name}</p>
                <p class="text-xs text-[var(--white-icon)]">{lang.level}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
