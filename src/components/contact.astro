<section id="contact" class="w-full py-12 sm:py-16 border-t border-[#ffffff10]">
  <div class="space-y-6 sm:space-y-8">
    <div>
      <h2 class="text-base sm:text-lg text-[var(--sec)] mb-1.5 shiny-sec font-medium">Let's Connect</h2>
      <h3 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-[var(--white)] tracking-tight">
        Contact Me
      </h3>
      <p class="text-[var(--white-icon)] text-sm sm:text-base md:text-lg max-w-2xl mt-1.5 sm:mt-2">
        Whether you have an upcoming web project, a role opening, or want to discuss collaborating on software engineering solutions, I'd love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
      <!-- Contact Info Cards -->
      <div class="lg:col-span-5 space-y-3.5 sm:space-y-4">
        <!-- Email Card -->
        <a
          href="mailto:chaudharymaryam346@gmail.com"
          class="flex items-start gap-3.5 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)] hover:border-[var(--sec)] transition-all duration-300 group"
        >
          <div class="p-2.5 sm:p-3 rounded-xl bg-[#ffffff08] border border-[#ffffff10] text-[var(--sec)] group-hover:scale-110 transition-transform flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] sm:text-xs uppercase font-semibold tracking-wider text-[var(--white-icon)]">Email Address</p>
            <p class="text-xs sm:text-sm md:text-base font-medium text-white truncate group-hover:text-[var(--sec-bright)] transition-colors">
              chaudharymaryam346@gmail.com
            </p>
            <p class="text-[11px] sm:text-xs text-[var(--white-icon)] mt-0.5">Click to compose message</p>
          </div>
        </a>

        <!-- Phone / WhatsApp Card -->
        <a
          href="https://wa.me/923325680756"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-3.5 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)] hover:border-[#34d399] transition-all duration-300 group"
        >
          <div class="p-2.5 sm:p-3 rounded-xl bg-[#ffffff08] border border-[#ffffff10] text-[#34d399] group-hover:scale-110 transition-transform flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] sm:text-xs uppercase font-semibold tracking-wider text-[var(--white-icon)]">Phone &amp; WhatsApp</p>
            <p class="text-xs sm:text-sm md:text-base font-medium text-white truncate group-hover:text-[#34d399] transition-colors">
              +92 332 5680756
            </p>
            <p class="text-[11px] sm:text-xs text-[var(--white-icon)] mt-0.5">Call or WhatsApp chat</p>
          </div>
        </a>

        <!-- Location Card -->
        <div class="flex items-start gap-3.5 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)]">
          <div class="p-2.5 sm:p-3 rounded-xl bg-[#ffffff08] border border-[#ffffff10] text-[var(--sec-bright)] flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] sm:text-xs uppercase font-semibold tracking-wider text-[var(--white-icon)]">Location</p>
            <p class="text-xs sm:text-sm md:text-base font-medium text-white break-words">
              Kotli, Azad Kashmir, Pakistan
            </p>
            <p class="text-[11px] sm:text-xs text-[var(--white-icon)] mt-0.5">Open to Remote &amp; On-Site Roles</p>
          </div>
        </div>
      </div>

      <!-- Contact Message Form -->
      <div class="lg:col-span-7 p-5 sm:p-7 md:p-8 rounded-2xl bg-[#141418] border border-[var(--white-icon-tr)]">
        <h4 class="text-lg sm:text-xl font-semibold text-white mb-1.5">Send a Message</h4>
        <p class="text-xs sm:text-sm text-[var(--white-icon)] mb-5">
          Fill out the form below and I will get back to you as soon as possible.
        </p>

        <form
          id="contact-form"
          action="https://formspree.io/f/chaudharymaryam346@gmail.com"
          method="POST"
          class="flex flex-col gap-3.5 sm:gap-4"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
            <div>
              <label for="from_name" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Your Name</label>
              <input
                id="from_name"
                type="text"
                name="from_name"
                placeholder="Maryam Naz"
                required
                class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 bg-[#0d0d12] text-[var(--white)] text-base sm:text-sm border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all placeholder:text-[#555]"
              />
            </div>
            <div>
              <label for="reply_to" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Your Email</label>
              <input
                id="reply_to"
                type="email"
                name="reply_to"
                placeholder="name@example.com"
                required
                class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 bg-[#0d0d12] text-[var(--white)] text-base sm:text-sm border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all placeholder:text-[#555]"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Subject / Project Type</label>
            <input
              id="subject"
              type="text"
              name="subject"
              placeholder="e.g. Web Development or Software Project Inquiry"
              class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 bg-[#0d0d12] text-[var(--white)] text-base sm:text-sm border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all placeholder:text-[#555]"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Your Message</label>
            <textarea
              id="message"
              name="message"
              placeholder="Tell me about your project, idea, or role requirements..."
              rows="4"
              required
              class="w-full px-3.5 sm:px-4 py-2.5 sm:py-3 bg-[#0d0d12] text-[var(--white)] text-base sm:text-sm border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all placeholder:text-[#555] resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 sm:py-3.5 px-6 bg-[var(--sec)] text-[#0d0d0f] font-semibold text-sm sm:text-base rounded-xl hover:bg-[#c09eff] transition-all duration-300 shadow-lg shadow-[rgba(164,118,255,0.2)] hover:scale-[1.01] cursor-pointer"
          >
            Send Message
          </button>
        </form>

        <div
          id="form-message"
          class="hidden text-center p-5 rounded-xl bg-[#34d399]/10 border border-[#34d399]/30 text-white mt-4"
        >
          <div class="text-2xl mb-1">✅</div>
          <p class="font-semibold text-sm sm:text-base text-[#34d399]">Thank you for reaching out!</p>
          <p class="text-xs text-[var(--white-icon)] mt-1">Your message has been received. I'll get back to you shortly.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");
  const submitBtn = document.getElementById("submit-btn");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const originalText = submitBtn.textContent;
      submitBtn.textContent = "Sending...";
      submitBtn.disabled = true;

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
        } else {
          // If formspree endpoint is placeholder, fallback gracefully to mailto
          const name = formData.get("from_name");
          const subject = formData.get("subject") || "Portfolio Inquiry";
          const body = formData.get("message");
          window.location.href = `mailto:chaudharymaryam346@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("From: " + name + "\n\n" + body)}`;
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
        }
      } catch (error) {
        // Fallback to mailto
        const name = formData.get("from_name") || "";
        const subject = formData.get("subject") || "Portfolio Inquiry";
        const body = formData.get("message") || "";
        window.location.href = `mailto:chaudharymaryam346@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("From: " + name + "\n\n" + body)}`;
        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>
