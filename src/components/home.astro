---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section class="text-[var(--white)] w-full" id="home">
  <div class="space-y-8 sm:space-y-12 pt-16 sm:pt-24 md:pt-28 pb-10 sm:pb-16">
    <!-- Hero Header -->
    <div class="text-left space-y-4 sm:space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#181822] border border-[var(--white-icon-tr)] text-xs sm:text-sm text-[var(--sec-bright)] max-w-full">
        <span class="inline-block size-2 rounded-full bg-[#34d399] animate-pulse flex-shrink-0"></span>
        <span class="truncate">Available for Web &amp; Software Engineering Roles</span>
      </div>

      <div class="space-y-2 sm:space-y-3">
        <p class="text-base sm:text-lg md:text-xl text-[var(--white-icon)] font-medium">
          Hi, I'm <span class="text-white font-semibold">Maryam Naz</span>
        </p>
        <h1 class="text-[var(--white)] text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.12] break-words">
          Software Engineer <br class="hidden sm:inline" />
          <span class="text-[var(--sec)] shiny-sec">&amp; Web Developer</span>
        </h1>
        <p class="text-sm sm:text-lg md:text-xl text-[var(--white-icon)] max-w-3xl leading-relaxed font-normal pt-1 sm:pt-2">
          Software Engineering student and Junior Web Developer who builds responsive websites and web applications, from clean front ends to cloud-based systems. Hands-on with <span class="text-white font-medium">React, Firebase, Supabase, Python, C++, and WordPress</span>, leveraging modern AI prompt engineering for high-velocity coding and quality delivery. Also skilled in graphic design, logo design, and multimedia editing.
        </p>
      </div>

      <!-- Quick Meta Badges -->
      <div class="flex flex-wrap gap-2 text-xs sm:text-sm text-[var(--white-icon)] pt-1">
        <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#ffffff08] border border-[#ffffff10]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)] flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="truncate">Kotli, Azad Kashmir, Pakistan</span>
        </span>
        <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#ffffff08] border border-[#ffffff10]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)] flex-shrink-0"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span class="truncate">Junior Web Developer (2025 – Present)</span>
        </span>
        <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#ffffff08] border border-[#ffffff10]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)] flex-shrink-0"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <span class="truncate">BS Software Engineering (2022 – 2026)</span>
        </span>
      </div>

      <!-- Action Buttons & Direct Contact -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3.5 pt-2 sm:pt-4">
        <a
          href="#projects"
          class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-[var(--sec)] text-[#0d0d0f] font-semibold text-sm sm:text-base hover:bg-[#c09eff] transition-all duration-300 shadow-lg shadow-[rgba(164,118,255,0.2)] hover:scale-105"
        >
          <span>Explore Projects</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-[#181822] text-white border border-[var(--white-icon-tr)] font-medium text-sm sm:text-base hover:bg-[#232332] hover:border-[#ffffff30] transition-all duration-300"
        >
          <span>Get in Touch</span>
        </a>

        <div class="flex items-center gap-2 pt-1 sm:pt-0">
          <a
            href="mailto:chaudharymaryam346@gmail.com"
            aria-label="Email Maryam Naz"
            title="chaudharymaryam346@gmail.com"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] p-2.5 sm:p-3 rounded-xl bg-[#141418] hover:bg-[#202028]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>

          <a
            href="https://wa.me/923325680756"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp Maryam Naz"
            title="+92 332 5680756"
            class="text-[var(--white-icon)] hover:text-[#34d399] transition duration-300 border border-[var(--white-icon-tr)] p-2.5 sm:p-3 rounded-xl bg-[#141418] hover:bg-[#202028]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>

          <a
            href="https://github.com/engrmaryam14"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] p-2.5 sm:p-3 rounded-xl bg-[#141418] hover:bg-[#202028]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Tech Stack Scroller -->
    <LogoWall />

    <!-- Skills & Glitch Section -->
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 sm:gap-12 pt-2">
      <div class="w-full lg:max-w-xl">
        <SkillsList client:load />
      </div>
      <div class="w-full flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[280px] sm:max-w-[320px] aspect-square rounded-3xl overflow-hidden border border-[#ffffff15] shadow-2xl bg-[#121218]">
          <LetterGlitch
            client:load
            glitchColors={["#5e4491", "#A476FF", "#241a38"]}
            glitchSpeed={33}
            centerVignette={false}
            outerVignette={true}
            smooth={true}
          />
          <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-[#0d0d0f]/90 via-transparent to-transparent flex items-end p-4 sm:p-5">
            <div>
              <p class="text-[10px] sm:text-xs uppercase tracking-widest text-[var(--sec-bright)] font-semibold">Engineering Philosophy</p>
              <p class="text-xs sm:text-sm text-white font-medium leading-snug">Clean Code • AI Acceleration • Scalable Architecture</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #f1eaff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 4s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
